# ---------------------------------------------------------------------------
# Silas Radio 91.7 — environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, OG images, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://silasradio917.co.ke

# Live stream endpoint (Icecast/Shoutcast/HLS). Falls back to bundled demo audio.
NEXT_PUBLIC_STREAM_URL=https://stream.silasradio917.co.ke/live.mp3

# WhatsApp (spec-mandated song-request / advertising number)
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061
WHATSAPP_NUMBER=254112272061

# Google Maps embed for the studio address (Contact section)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED=https://www.google.com/maps/embed?pb=PLACEHOLDER

# --- reCAPTCHA v3 (site key is public, secret is server-only) ---------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Vercel KV: song requests, contest entries, listener count --------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Mail (Nodemailer) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
STUDIO_NOTIFICATION_EMAIL=studio@silasradio917.co.ke
NEWSLETTER_FROM="Silas Radio 91.7 <newsletter@silasradio917.co.ke>"
