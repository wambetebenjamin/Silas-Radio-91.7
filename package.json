{
  "name": "silas-radio-917",
  "version": "1.0.0",
  "private": true,
  "description": "Silas Radio 91.7 \u2014 Nairobi community radio station. Live stream, shows, podcasts, local news, advertising. Design source: Colorlib DJoz (see DESIGN-INSPECTION.md).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run verify:fonts:hashes && npm run verify:images:strict && npm run lint",
    "verify:fonts": "node scripts/verify-fonts.mjs",
    "verify:fonts:hashes": "node scripts/verify-fonts.mjs --strict",
    "verify:images": "node scripts/verify-images.mjs",
    "verify:images:strict": "node scripts/verify-images.mjs --strict",
    "audit:rendered": "node scripts/audit-rendered.mjs"
  },
  "dependencies": {
    "@fontsource/rajdhani": "5.1.0",
    "@vercel/kv": "3.0.0",
    "gray-matter": "4.0.3",
    "lucide-react": "0.468.0",
    "next": "15.1.12",
    "next-mdx-remote": "5.0.0",
    "nodemailer": "6.9.16",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "0.172.0",
    "wavesurfer.js": "7.8.11",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/three": "0.172.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.12",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
